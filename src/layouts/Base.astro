---
import Consent from '../components/Consent.astro';
import '@fontsource/familjen-grotesk/400.css';
import '@fontsource/familjen-grotesk/500.css';
import '@fontsource/familjen-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'case' | 'tjanster' | 'om';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]; // strukturerad data (schema.org)
}
const { title, description = SITE.description, image = SITE.image, current, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
---
<!doctype html>
<html lang="sv">
  <head>
    <!-- Consent Mode: allt nekat tills besökaren godkänner (se Consent.astro) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied', wait_for_update: 500 });
      try { if (localStorage.getItem('ld-consent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-N37T27FZ');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="google-site-verification" content="5pzqCCfa2xrhhKKGtgD9OtYNkBVhd55MfSWFX8QH82Y" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!SITE.indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href={url('/sitemap.xml')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta name="theme-color" content="#F4F2EE" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N37T27FZ" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Consent />
    <a class="skip" href="#main">Hoppa till innehållet</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer>
      <slot name="dark" />
    </Footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Header: namnet glider in bakom markören, markören skjuts ut till LD-blocket.
      const hdr = document.getElementById('hdr');
      const onScroll = () => hdr?.classList.toggle('compact', window.scrollY > 80);
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Mobilmeny
      const btn = document.getElementById('menuBtn');
      const menu = document.getElementById('mobileMenu');
      const setMenu = (open: boolean) => {
        if (!btn || !menu) return;
        menu.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        btn.textContent = open ? 'Stäng' : 'Meny';
      };
      btn?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
      menu?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false);
      });

      // Sektionsrubriker skrivs ut när de kommer i bild.
      if (!reduce && 'IntersectionObserver' in window) {
        document.querySelectorAll<HTMLElement>('h2[data-type]').forEach((h) => {
          if (h.getBoundingClientRect().top < innerHeight) return;
          const full = h.textContent ?? '';
          h.setAttribute('aria-label', full);
          h.style.minHeight = h.offsetHeight + 'px';
          h.innerHTML = '<span class="tx" aria-hidden="true"></span><span class="cur" aria-hidden="true"></span>';
          h.classList.add('typed-wait');
          const scope = h.closest('.sec-in') ?? h.parentElement!;
          const rev = Array.from(scope.querySelectorAll<HTMLElement>('.reveal'));
          rev.forEach((el) => el.classList.add('pre-reveal'));
          const io = new IntersectionObserver((entries) => {
            if (!entries.some((en) => en.isIntersecting)) return;
            io.disconnect();
            setTimeout(() => {
              h.classList.replace('typed-wait', 'typing');
              const tx = h.querySelector('.tx')!;
              let i = 0;
              const iv = setInterval(() => {
                tx.textContent = full.slice(0, ++i);
                if (i >= full.length) {
                  clearInterval(iv);
                  h.classList.replace('typing', 'typed-wait');
                  rev.forEach((el, k) => setTimeout(() => el.classList.remove('pre-reveal'), 120 * k));
                  setTimeout(() => { h.classList.remove('typed-wait'); h.style.minHeight = ''; }, 3000);
                }
              }, 45);
            }, 1200);
          }, { threshold: 0.6 });
          io.observe(h);
        });
      }
    </script>
  </body>
</html>
