---
import { SITE } from '../config';
interface Props { number?: string }
const { number = '06' } = Astro.props;
const hasEmail = !SITE.email.startsWith('[');
const hasPhone = SITE.phone && !SITE.phone.startsWith('[');
---
<section class="wrap contact" id="kontakt">
  <span class="lbl" style="grid-column:1 / -1">{number}<span class="sig">|</span> kontakt</span>
  <div class="a">
    <h2>Behöver du en ny sajt?</h2>
    <p class="lead">Boka ett kostnadsfritt samtal på 30 minuter. Jag svarar inom 24 timmar på vardagar.</p>
    <div class="contact-list">
      {hasEmail ? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> : <span class="todo" style="color:#121212">[e-postadress]</span>}
      {hasPhone && <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>}
      {SITE.bookingUrl && <a href={SITE.bookingUrl}>Boka direkt i kalendern <span class="sig">|</span> →</a>}
    </div>
  </div>
  <div class="tally-wrap">
    {SITE.tallyFormId ? (
      <iframe
        data-tally-src={`https://tally.so/embed/${SITE.tallyFormId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`}
        loading="lazy" width="100%" height="620" frameborder="0" marginheight="0" marginwidth="0"
        title="Kontaktformulär"></iframe>
    ) : (
      <p class="lead">Formuläret är inte kopplat ännu. Mejla mig på <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    )}
  </div>
</section>

<script is:inline>
  // Tallys inbäddning: laddar skriptet en gång och sätter formulärets höjd automatiskt.
  (function () {
    var d = document, w = 'https://tally.so/widgets/embed.js';
    var v = function () {
      if (typeof Tally !== 'undefined') Tally.loadEmbeds();
      else d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (e) { e.src = e.dataset.tallySrc; });
    };
    if (typeof Tally !== 'undefined') v();
    else if (!d.querySelector('script[src="' + w + '"]')) { var s = d.createElement('script'); s.src = w; s.onload = v; s.onerror = v; d.body.appendChild(s); }
  })();
</script>
