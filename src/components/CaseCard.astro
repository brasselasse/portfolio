---
import { url } from '../lib/url';
import type { CaseData } from '../lib/cases';
interface Props { slug: string; data: CaseData }
const { slug, data } = Astro.props;
---
<a class="case" href={url(`/case/${slug}/`)}>
  <img class="cover" src={url(data.cover)} alt={data.coverAlt} width="1600" height="1000" loading="lazy" decoding="async" />
  <h3>{data.title}</h3>
  <p>{data.summary}</p>
  <span class="lbl">{data.type} <span class="sig">|</span> {data.year}</span>
</a>
