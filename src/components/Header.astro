---
import { url } from '../lib/url';
interface Props { current?: string }
const { current } = Astro.props;
const links = [
  { href: '/#case', label: 'Case', key: 'case' },
  { href: '/#tjanster', label: 'Tjänster', key: 'tjanster' },
  { href: '/#om', label: 'Om mig', key: 'om' },
];
---
<header class="site-header" id="hdr">
  <div class="wrap bar">
    <a class="brand" href={url('/')} aria-label="Lars Dahlberg, till startsidan">
      <span class="b-blk" aria-hidden="true"><span class="b-ld">LD</span></span>
      <span class="b-clip" aria-hidden="true"><span class="b-name">Lars Dahlberg</span></span>
    </a>
    <nav class="nav" aria-label="Huvudmeny">
      {links.map((l) => <a href={url(l.href)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
      <a href={url('/#kontakt')} class="btn btn-p">Anlita mig</a>
    </nav>
    <div class="mob">
      <a href={url('/#kontakt')} class="btn btn-p hdr-cta" style="min-height:44px;padding:0 14px;font-size:15px">Anlita mig</a>
      <button type="button" class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mobileMenu">Meny</button>
    </div>
  </div>
  <nav class="mobile-menu" id="mobileMenu" aria-label="Huvudmeny" hidden>
    <div class="wrap">
      {links.map((l) => <a href={url(l.href)}>{l.label} <span class="sig">|</span></a>)}
      <a href={url('/#kontakt')}>Kontakt <span class="sig">|</span></a>
    </div>
  </nav>
</header>
